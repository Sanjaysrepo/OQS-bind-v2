# Build dependencies for OQS-bind: Debian trixie (OpenSSL >= 3.2), liboqs
# and oqs-provider built from source, oqsprovider activated system-wide.
#
#   docker build -f Dockerfile.deps -t oqs-bind-deps .
#
# Behind a TLS-inspecting proxy `git clone` inside the container may fail;
# clone liboqs/ and oqs-provider/ next to this file and pass
# --build-arg SOURCES=local instead (the sources are then COPYed in).
FROM debian:trixie
ARG SOURCES=git
ARG LIBOQS_REF=main
ARG OQSPROVIDER_REF=main
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential autoconf automake libtool pkg-config cmake ninja-build git ca-certificates curl \
    libssl-dev openssl libuv1-dev liburcu-dev libnghttp2-dev libcap-dev libjemalloc-dev libcmocka-dev \
    python3 python3-pytest tcpdump iproute2 procps less \
    && rm -rf /var/lib/apt/lists/*
COPY . /tmp/ctx
RUN set -e; \
    if [ "$SOURCES" = "local" ]; then \
        mv /tmp/ctx/liboqs /tmp/liboqs && mv /tmp/ctx/oqs-provider /tmp/oqsprov; \
    else \
        git clone --depth 1 --branch "$LIBOQS_REF" https://github.com/open-quantum-safe/liboqs.git /tmp/liboqs; \
        git clone --depth 1 --branch "$OQSPROVIDER_REF" https://github.com/open-quantum-safe/oqs-provider.git /tmp/oqsprov; \
    fi; \
    rm -rf /tmp/ctx; \
    cmake -S /tmp/liboqs -B /tmp/liboqs/build -GNinja -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON -DOQS_BUILD_ONLY_LIB=ON -DOQS_DIST_BUILD=ON; \
    cmake --build /tmp/liboqs/build && cmake --install /tmp/liboqs/build && ldconfig; \
    rm -rf /tmp/liboqs; \
    cmake -S /tmp/oqsprov -B /tmp/oqsprov/build -GNinja -DCMAKE_BUILD_TYPE=Release; \
    cmake --build /tmp/oqsprov/build && cmake --install /tmp/oqsprov/build; \
    rm -rf /tmp/oqsprov
# Activate oqsprovider (and default) in the system openssl.cnf
RUN sed -i 's/^\[provider_sect\]/[provider_sect]\noqsprovider = oqsprovider_sect/' /etc/ssl/openssl.cnf \
    && sed -i 's/^# *activate = 1/activate = 1/' /etc/ssl/openssl.cnf \
    && printf '\n[oqsprovider_sect]\nactivate = 1\n' >> /etc/ssl/openssl.cnf \
    && openssl list -providers \
    && openssl list -signature-algorithms | grep -c -E "falcon|mldsa|slhdsa|mayo|snova"
WORKDIR /src
CMD ["bash"]
